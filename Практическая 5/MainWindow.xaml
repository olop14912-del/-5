<Window x:Class="Практическая_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая работа №5. Класс Triad"
        Height="430"
        Width="620"
        MinHeight="430"
        MinWidth="620"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок программы -->
        <TextBlock Grid.Row="0"
                   Text="Демонстрация операций класса Triad"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Блок ввода исходных данных -->
        <GroupBox Grid.Row="1"
                  Header="Исходные данные"
                  Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="Первое"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Второе"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="Третье"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Триада A:"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="TxtA1"
                         Grid.Row="1"
                         Grid.Column="1"
                         Text="1"
                         Margin="4"/>

                <TextBox x:Name="TxtA2"
                         Grid.Row="1"
                         Grid.Column="2"
                         Text="2"
                         Margin="4"/>

                <TextBox x:Name="TxtA3"
                         Grid.Row="1"
                         Grid.Column="3"
                         Text="3"
                         Margin="4"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Триада B:"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="TxtB1"
                         Grid.Row="2"
                         Grid.Column="1"
                         Text="4"
                         Margin="4"/>

                <TextBox x:Name="TxtB2"
                         Grid.Row="2"
                         Grid.Column="2"
                         Text="5"
                         Margin="4"/>

                <TextBox x:Name="TxtB3"
                         Grid.Row="2"
                         Grid.Column="3"
                         Text="6"
                         Margin="4"/>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Число:"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="TxtNumber"
                         Grid.Row="3"
                         Grid.Column="1"
                         Text="10"
                         Margin="4"/>
            </Grid>
        </GroupBox>

        <!-- Кнопки операций -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10">

            <Button Content="Триада A + число"
                    Width="150"
                    Margin="4"
                    Click="BtnAddNumber_Click"/>

            <Button Content="Триада A + Триада B"
                    Width="170"
                    Margin="4"
                    Click="BtnAddTriads_Click"/>

            <Button Content="Очистить"
                    Width="100"
                    Margin="4"
                    Click="BtnClear_Click"/>
        </StackPanel>

        <!-- Поле результата -->
        <TextBox x:Name="TxtResult"
                 Grid.Row="3"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="14"
                 Margin="0,0,0,10"/>

        <!-- Обязательные кнопки: О программе и Выход -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="О программе"
                    Width="120"
                    Margin="4"
                    Click="BtnAbout_Click"/>

            <Button Content="Выход"
                    Width="120"
                    Margin="4"
                    Click="BtnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>